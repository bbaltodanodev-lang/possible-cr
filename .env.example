# ─────────────────────────────────────────────────────────────
# BM Solutions — Variables de entorno (copiar a .env.local)
# ─────────────────────────────────────────────────────────────
# URL pública del sitio. Con dominio propio, ej: https://bmsolutions.com
NEXT_PUBLIC_SITE_URL=https://bmsolutions.example.com

# Endpoint del backend de contacto (opcional).
# Por defecto se usa /api/contact, que envía la solicitud al correo de BM Solutions.
# Puedes reemplazarlo por Formspree, FormSubmit u otra API propia.
NEXT_PUBLIC_CONTACT_ENDPOINT=
